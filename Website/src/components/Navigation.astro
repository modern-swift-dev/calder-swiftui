---
import { internalPath, repositoryURL } from "../lib/links";

const currentPath = Astro.url.pathname;
const links = [
  { href: internalPath("/"), label: "Overview" },
  { href: internalPath("/documentation/"), label: "Documentation" }
];
---

<header class="border-b border-sky-100 bg-white/85 backdrop-blur">
  <nav class="page-shell flex min-h-16 flex-wrap items-center justify-between gap-x-2 gap-y-1 py-2 sm:flex-nowrap sm:gap-5" aria-label="Main navigation">
    <a class="flex items-center gap-2 font-semibold tracking-tight text-ink no-underline" href={internalPath("/")}>
      <span class="grid size-8 place-items-center rounded-xl bg-gradient-to-br from-sky-700 to-teal-600 text-sm font-bold text-white">C</span>
      Calder
    </a>
    <div class="flex flex-wrap items-center gap-0.5 sm:gap-3">
      {links.map((link) => <a class:list={["rounded-lg px-2 py-2 text-xs no-underline transition hover:bg-sky-50 hover:text-sky-ink sm:px-2.5 sm:text-sm", currentPath === link.href && "bg-sky-50 text-sky-ink"]} href={link.href}>{link.label}</a>)}
      <a class="hidden rounded-lg px-2.5 py-2 text-sm text-muted transition hover:text-sky-ink sm:inline" href={repositoryURL}>GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
