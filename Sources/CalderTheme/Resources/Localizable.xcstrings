    "barcodeScanner.permissionDenied.message" : {
      "comment" : "Explanation shown when camera access is off, telling the user to allow it in Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow camera access in Settings to scan codes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la cámara en Ajustes para escanear códigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès à l'appareil photo dans les Réglages pour scanner des codes."
          }
        }
      }
    },
    "barcodeScanner.permissionDenied.openSettings" : {
